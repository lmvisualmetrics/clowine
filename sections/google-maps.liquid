{%- style -%}
  .google-maps {
    width: 100%;
  }

  #cmap {
  }

  .leaflet-container {
    height: 600px;
    width: 100%;
    max-width: 100%;
    max-height: 100%;
    font-family: inherit !important;
    font-size: inherit !important;
    font-size: inherit !important;
  }

  .leaflet-container h2 {
    font-style: bold;
    text-transform: uppercase;
  }

  .leaflet-container p {
    font-size: 14px;
  }

  .leaflet-container a {
    font-style: bold;
    font-size: 14px;
    color: #333;
  }
{%- endstyle -%}

<div id="cmap" class="google-maps">
</div>

<script type="text/javascript">
  map = L.map('cmap', {
    doubleClickZoom: false
  }).setView([{{ section.settings.default_latitude }}, {{ section.settings.default_longitude }}], 7);

  tiles = L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
    zoom: 10,
    minZoom: 5,
    maxZoom: 15
  }).addTo(map);

  {% for block in section.blocks %}
    sunnyside = L.marker([{{ block.settings.latitude }}, {{ block.settings.longitude }}]).addTo(map)
      .bindPopup('<h2>{{ block.settings.heading }}</h2><p>{{ block.settings.description }}</p><a href="{{ block.settings.link }}">Explore {{ block.settings.heading }}</a>').openPopup();
  {% endfor %}

  map.on('click', onMapClick);
</script>

{% schema %}
{
  "name": "Maps",
  "settings": [
    {
      "type": "text",
      "id": "default_latitude",
      "label": "Default Latitude",
      "default": "51.5",
      "info": "Enter the default location latitude"
    },
    {
      "type": "text",
      "id": "default_longitude",
      "label": "Default Longitude",
      "default": "-0.1",
      "info": "Enter the default location longitude"
    }
  ],
  "blocks": [
    {
      "type": "location",
      "name": "Location",
      "settings": [
        {
          "type": "text",
          "id": "latitude",
          "label": "Latitude",
          "default": "51.5"
        },
        {
          "type": "text",
          "id": "longitude",
          "label": "Longitude",
          "default": "-0.1"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Location"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Short Description",
          "default": "Planted in 1987 to Pinot Noir, Sunnyside is located on the outskirts of the Tumbarumba township. The vineyard had not been tended to for over two decades and had to be regrown from the ground up."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Location Link"
        }
      ]
    }
  ],
  "tag": "section",
  "class": "section",
  "presets": [
    {
      "name": "Maps",
      "blocks": [
        {
          "type": "location"
        },
        {
          "type": "location"
        },
        {
          "type": "location"
        },
        {
          "type": "location"
        }
      ]
    }
  ]
}
{% endschema %}
